# ==============================================================================
# Veridian Assist — Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=true

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# SQLite Database Connection URL
DATABASE_URL=sqlite+aiosqlite:///./veridian.db

# LLM Provider Configuration
# Supported providers: "mock", "gemini", "openai"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# API Keys (Provider-specific)
# Set the relevant key for your selected LLM_PROVIDER
GEMINI_API_KEY=
OPENAI_API_KEY=

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authoritative Data Pack Path
DATAPACK_PATH=../data/source/Assignment_2_DataPack.pdf
